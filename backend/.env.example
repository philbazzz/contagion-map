# Copy this file to "backend/.env" and fill in your own keys.
# .env is read only by the backend. Never commit it or share it.

# FRED API key (HY OAS, series BAMLH0A0HYM2) — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Vast.ai API key (GPU rental listings) — https://cloud.vast.ai/manage-keys/
VASTAI_API_KEY=

# Finnhub API key (US-listed share prices) — https://finnhub.io/dashboard
FINNHUB_API_KEY=

# 공공데이터포털 서비스키 (금융위원회_주식시세정보: SK hynix 등 KRX 일간 종가) — https://www.data.go.kr
DATA_GO_KR_SERVICE_KEY=

# 한국수출입은행 환율 API 인증키 — https://www.koreaexim.go.kr (Open API)
KOREAEXIM_API_KEY=

# Open DART API key (금융감독원 전자공시) — https://opendart.fss.or.kr/
# Server-side only. Never put this in frontend code, commits, docs, or screenshots.
OPEN_DART_API_KEY=

# Automatic collection while the backend is running (true/false)
MARKET_SCHEDULER=true

# Optional: override GPU comparison conditions (JSON). Example:
# GPU_CONDITION_JSON={"gpu_name":["H100 SXM"],"rental_type":"ondemand","region":"ALL"}
GPU_CONDITION_JSON=

# ICE BofA (HY OAS) data may not be redistributed without ICE permission. Keep false.
HY_OAS_PUBLIC_EXPORT=false

# Optional: custom database location
MARKET_DB_PATH=
